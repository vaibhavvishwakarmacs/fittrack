# ==============================================================================
# FitTrack Full-Stack Environment Configuration (Node.js + Express + MongoDB)
# ==============================================================================

# Backend Server Port (using 5001 to avoid default macOS AirPlay conflict on 5000)
PORT=5001

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/fittrack

# JWT Secret for Session Signing & Authentication
JWT_SECRET=fittrack_production_jwt_secret_key_change_in_production

# Optional frontend API base (defaults to empty string in development to use Vite proxy)
VITE_API_URL=
