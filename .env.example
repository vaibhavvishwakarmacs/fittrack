# ==============================================================================
# FitTrack Full-Stack Environment Configuration (Node.js + Express + MongoDB)
# ==============================================================================

# Backend Server Port (using 5001 to avoid default macOS AirPlay conflict on 5000)
PORT=5001

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/fittrack

# JWT Secret for Session Signing & Authentication
JWT_SECRET=fittrack_production_jwt_secret_key_change_in_production

# Optional frontend API base (defaults to empty string in development to use Vite proxy)
VITE_API_URL=

# ==============================================================================
# Cloudinary Image Upload Configuration (Required for Live Image Storage)
# Get your free credentials at https://cloudinary.com/console
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# AI Vision Nutrition Assistant (Free Google Gemini API / OpenAI)
# Get a 100% Free Gemini API key (1,500 free daily scans) at: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
OPENAI_API_KEY=

